APP_NAME="Image API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Defaults target a zero-dependency local run: SQLite, local disk, inline
# queue. The Docker stack overrides all of this with PostgreSQL, Redis and
# MinIO through environment variables in compose.yaml.
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=dmed
# DB_USERNAME=dmed
# DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120

CACHE_STORE=file
QUEUE_CONNECTION=sync

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

FILESYSTEM_DISK=local

# Image pipeline
IMAGES_DISK=images
IMAGES_MAX_UPLOAD_KB=5120
IMAGES_MAX_MEGAPIXELS=25
IMAGES_WEBP_QUALITY=82
IMAGES_MAX_DIMENSION=4096
IMAGES_DRIVER=gd
IMAGES_QUEUE=images
IMAGES_PRUNE_DELAY=60
# Above zero, downloads redirect to a temporary signed URL of the object
# store instead of streaming through PHP.
IMAGES_SIGNED_URL_TTL=0

# Object storage, used when IMAGES_DISK=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

MAIL_MAILER=log
